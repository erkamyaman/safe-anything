{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "{{fake:github}}"
      }
    },
    "pinned": {
      "command": "npx",
      "args": ["-y", "@acme/mcp-tools@1.4.2"],
      "env": { "API_KEY": "${API_KEY}" }
    },
    "fetch": { "command": "uvx", "args": ["mcp-server-fetch"] },
    "fetch2": { "command": "uvx", "args": ["mcp-server-fetch==2025.4.7"] },
    "box": { "command": "docker", "args": ["run", "-i", "--rm", "acme/mcp"] },
    "remote": { "url": "http://mcp.acme-tools.io/sse" },
    "local": { "url": "http://localhost:3000/mcp" },
    "tls": { "url": "https://mcp.acme-tools.io/mcp" },
    "empty": { "command": "npx", "args": [""] },
    "empty-dlx": { "command": "pnpm", "args": ["dlx", ""] },
    "accent": { "command": "npx", "args": ["é@1.0.0"] }
  }
}
